{
  "manifest_version": 3,
  "name": "RollerWin Capture",
  "version": "9.1",
  "description": "Captura numeros de ruleta en Betfury y Pinnacle — envia al dashboard RollerWin",
  "permissions": ["scripting", "activeTab", "storage", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.betfury.com/*", "*://*.betfury.io/*", "*://*.pinnacle.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject-main.js"],
      "matches": ["<all_urls>"]
    }
  ]
}