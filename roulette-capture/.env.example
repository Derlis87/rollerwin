# ============================================================
# ROULETTE CAPTURE v5.0 — Configuracion
# ============================================================
# COPIA ESTE ARCHIVO COMO .env y completa los valores
# ============================================================

# --- OBLIGATORIO ---
# Modo headed (Chrome visible) — REQUERIDO para captura OCR
HEADED=true

# Ruta a chrome.exe en tu PC
# Ejemplo Windows: CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Ejemplo portable: CHROME_PATH=C:\Users\TuUsuario\Desktop\chrome-win\chrome.exe
CHROME_PATH=

# Puerto CDP de Chrome (no cambiar salvo conflicto)
CDP_PORT=9222

# --- CASINOS ---
# true/false para activar cada casino
BETFURY_ENABLED=true
PINNACLE_ENABLED=true
STAKE_ENABLED=false

# URLs de las mesas de ruleta
BETFURY_ROULETTE_URL=https://betfury.com/es/casino/games/roulette-live-by-evolution
PINNACLE_ROULETTE_URL=https://casino.pinnacle.com/es/live-casino/games/european-roulette/
STAKE_ROULETTE_URL=https://stake.com/casino/games/evolution/roulette

# --- CREDENCIALES (opcional — si no pones, pedira login manual) ---
BETFURY_EMAIL=
BETFURY_PASSWORD=
PINNACLE_EMAIL=
PINNACLE_PASSWORD=
STAKE_EMAIL=
STAKE_PASSWORD=

# --- ROLLERWIN API ---
ROLLERWIN_API_URL=https://rollerwin3.onrender.com/api/capture/receive

# --- OCR ---
# Intervalo entre escaneos (milisegundos) — menor = mas rapido pero mas CPU
OCR_INTERVAL=3000

# Region de escaneo en la pantalla (pixels)
# Ajusta estos valores segun donde aparece el resultado en tu pantalla
# Para resolucion 1920x1080:
OCR_CROP_X=0
OCR_CROP_Y=50
OCR_CROP_W=1920
OCR_CROP_H=400

# --- OPCIONES AVANZADAS ---
LOG_LEVEL=info
CHROME_PROFILE=./chrome-profile