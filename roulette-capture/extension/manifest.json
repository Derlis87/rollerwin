{
  "manifest_version": 3,
  "name": "RW Capture Bridge",
  "version": "2.0.0",
  "description": "Captura numeros de ruleta en iframes cross-origin y los envia al servidor local",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}